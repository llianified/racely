DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Prefer the direct Neon URL for migrations when available.
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://racely.example.com
PORT=3000
PM2_MAX_MEMORY=512M
# Development only. Production is forcibly disabled by NODE_ENV and PM2 config.
RACELY_ENABLE_PREVIEW=false
