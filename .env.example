DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Prefer the direct Neon URL for migrations when available.
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional. Defaults to RacelyBot; override for a staging bot.
TELEGRAM_BOT_USERNAME=
PUBLIC_APP_URL=https://racely.fun
PORT=3000
PM2_MAX_MEMORY=512M
# Read by ecosystem.config.cjs only. Env file lives outside the repo (chmod 600).
RACELY_ENV_FILE=/etc/racely/racely.env
# Optional PM2 log directory. Defaults to PM2's own log location when unset.
RACELY_LOG_DIR=/var/log/racely
# Nyalakan penyapu pemberitahuan idle di luar produksi (di produksi selalu aktif).
RACELY_IDLE_NOTIFY=false
# Development only. Production is forcibly disabled by NODE_ENV and PM2 config.
RACELY_ENABLE_PREVIEW=false
# Panel admin di /admin: antrean penarikan + config ekonomi. Minimal 16
# karakter; di bawah itu panelnya menolak menyala sama sekali. Kosong berarti
# panel mati (503) -- tidak ada bypass development untuk yang satu ini.
# Kunci penanda tangan sesi diturunkan dari nilai ini, jadi menggantinya
# langsung memutus semua sesi admin yang sedang berjalan.
RACELY_ADMIN_PASSWORD=
