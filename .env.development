# Hanya dimuat Next.js saat NODE_ENV=development.
# Build produksi (`pnpm run build:standalone`) tidak pernah membaca file ini,
# dan isPreviewBypassAllowed() tetap menolak kalau NODE_ENV !== "development",
# jadi flag ini tidak bisa bocor ke EC2.
#
# Bypass preview bersifat opt-in: isPreviewBypassAllowed() butuh flag ini
# tepat "true" BESERTA NODE_ENV=development. File ini yang menyalakannya, jadi
# `pnpm dev` dan preview v0 boleh melewati verifikasi Telegram initData dan
# memakai sesi preview tanpa konfigurasi tambahan.
#
# Sengaja opt-in, bukan opt-out: yang dilonggarkan adalah autentikasi pemain,
# jadi flag yang lupa disetel harus berarti gerbangnya tetap terkunci.
# Hapus baris ini atau set ke nilai lain kalau mau menguji gate Telegram lokal.
RACELY_ENABLE_PREVIEW=true

# Block rewarded Adsgram untuk uji coba. Bukan rahasia: id ini ikut ke bundle
# klien. Di produksi setel NEXT_PUBLIC_ADSGRAM_BLOCK_ID ke block milik
# racely.fun saat build; tanpa nilai tombol iklan disembunyikan.
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=47938
